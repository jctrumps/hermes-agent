---
hermes_app_name: hermes-agent
hermes_app_dir: /opt/hermes-agent
hermes_src_dir: /opt/hermes-agent/src
hermes_data_dir: /srv/hermes

# Upstream source used to build the Docker image locally.
hermes_repo_url: "https://github.com/NousResearch/hermes-agent.git"
hermes_repo_version: "main"

# Copy this file to hermes.yml; edit that local file, not this example.
# Leave provider overrides empty for ChatGPT/Codex browser login or providers
# selected inside Hermes. See docs/model-providers.md.
hermes_openai_base_url: ""
hermes_default_model: ""
# Optional future Ollama setup (on a separate model host):
# hermes_openai_base_url: "http://10.10.10.20:11434/v1"
# hermes_default_model: "openai/qwen3:30b-a3b"

# Leave dashboard localhost-only. Use SSH tunnel or the optional Cloudflare Tunnel:
# ssh -L 9119:127.0.0.1:9119 ubuntu@hermes-01
hermes_dashboard_host: "127.0.0.1"
hermes_dashboard_port: 9119

# Domain access: use the FULL HTTPS URL, e.g. "https://hermes.example.com".
# Keep empty only for SSH-tunnel/local-only access. No trailing slash.
# See docs/cloudflare-tunnel.md.
hermes_dashboard_public_url: ""
# This is your Hermes dashboard login name, not your Linux or Cloudflare login.
hermes_dashboard_username: "hermes-admin"
# false = install/manage cloudflared separately (the default).
# true = let this project's Compose stack run cloudflared; requires a vault token.
# This flag controls the connector only; false still allows domain access.
hermes_cloudflare_tunnel_enabled: false
# Used only when the Compose connector above is enabled.
hermes_cloudflared_image: "cloudflare/cloudflared:latest"
# Dashboard password HASH and session-signing secret belong in hermes_vault.yml.

# UFW = Ubuntu's Uncomplicated Firewall. Keep enabled; this project allows SSH.
# A same-VM Cloudflare Tunnel connects outbound and needs no inbound dashboard rule.
hermes_enable_ufw: true
# Keep false for SSH tunneling or a cloudflared connector on the Hermes VM.
hermes_allow_dashboard_from_lan: false
# Used ONLY if hermes_allow_dashboard_from_lan is true. This is a subnet,
# not the Hermes VM's IP. Leave this example unchanged while LAN access is false.
hermes_lan_cidr: "10.10.10.0/24"
