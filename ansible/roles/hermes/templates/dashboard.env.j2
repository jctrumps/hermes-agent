# Public hostname is also used by Hermes Host and WebSocket Origin validation.
HERMES_DASHBOARD_PUBLIC_URL={{ hermes_dashboard_public_url | to_json }}
HERMES_DASHBOARD_BASIC_AUTH_USERNAME={{ hermes_dashboard_username | to_json | replace('$', '$$') }}
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH={{ hermes_dashboard_password_hash | to_json | replace('$', '$$') }}
HERMES_DASHBOARD_BASIC_AUTH_SECRET={{ hermes_dashboard_session_secret | to_json | replace('$', '$$') }}
