HERMES_UID=1000
HERMES_GID=1000

# Optional OpenAI-compatible endpoint override. Leave unset for provider login in Hermes.
{% if hermes_openai_base_url | length > 0 %}
OPENAI_BASE_URL={{ hermes_openai_base_url | to_json | replace('$', '$$') }}
{% endif %}
{% if hermes_openai_api_key | default('') | length > 0 %}
OPENAI_API_KEY={{ hermes_openai_api_key | to_json | replace('$', '$$') }}
{% endif %}

# Optional model override. You can also change this inside Hermes.
{% if hermes_default_model | length > 0 %}
HERMES_MODEL={{ hermes_default_model | to_json | replace('$', '$$') }}
{% endif %}

# Separate API-server key; not used for dashboard authentication.
{% if hermes_api_server_key | default('') | length > 0 %}
API_SERVER_KEY={{ hermes_api_server_key | to_json | replace('$', '$$') }}
{% endif %}
