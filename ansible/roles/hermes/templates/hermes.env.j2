HERMES_UID=1000
HERMES_GID=1000

# OpenAI-compatible provider pointed at Ollama on Blade 6.
OPENAI_BASE_URL={{ hermes_openai_base_url }}
OPENAI_API_KEY={{ hermes_openai_api_key | default('ollama-local') }}

# Optional model override. You can also change this inside Hermes.
HERMES_MODEL={{ hermes_default_model }}

# Dashboard/API security placeholders.
API_SERVER_KEY={{ hermes_api_server_key | default('') }}
